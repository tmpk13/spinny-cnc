    "polar-laser": {
        "pad": true,
        "pad_steps": [
            0.1,
            1.0,
            10.0
        ],
        "pad_step": 1.0,
        "feed": true,
        "center": {
            "r": 0.0
        },
        "axes": [
            {
                "axis": "r",
                "letter": "R",
                "label": "Radius",
                "steps": null,
                "step": null,
                "buttons": [
                    "Radius -",
                    "Radius +"
                ],
                "feed": true,
                "goto": true,
                "zero": true,
                "zero_hint": "The beam must be over the rotation axis.",
                "keys": [],
                "note": ""
            },
            {
                "axis": "a",
                "letter": "A",
                "label": "Table",
                "steps": [
                    1.0,
                    10.0,
                    90.0
                ],
                "step": 10.0,
                "buttons": [
                    "Turn -",
                    "Turn +"
                ],
                "feed": true,
                "goto": true,
                "zero": true,
                "zero_hint": "",
                "keys": [],
                "note": ""
            },
            {
                "axis": "z",
                "letter": "Z",
                "label": "Cross slide",
                "steps": [
                    0.05,
                    0.1,
                    0.5
                ],
                "step": 0.1,
                "buttons": [
                    "Z-",
                    "Z+"
                ],
                "feed": false,
                "goto": false,
                "zero": true,
                "zero_hint": "The rail is over the axis when the centering lines meet at a point.",
                "keys": [],
                "note": "Setup only: carries the rail across the rotation axis"
            }
        ]
    },
