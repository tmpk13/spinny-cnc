[Unit]
Description=Spinny camera on port @PORT@ (pcbv serve)
# A camera not yet enumerated at boot makes pcbv exit; keep trying.
StartLimitIntervalSec=0

[Service]
User=@USER@
WorkingDirectory=@DIR@/pcb-vision
ExecStart=@DIR@/pcb-vision/target/debug/pcbv serve --camera @CAMERA@ --listen 127.0.0.1:@PORT@
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
