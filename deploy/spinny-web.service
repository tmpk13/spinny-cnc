[Unit]
Description=Spinny web backend
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
WorkingDirectory=@DIR@/spinny-laser-pcb
ExecStart=@UV@ run --no-dev --frozen spinny-web --connect auto @ALLOWED@
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
